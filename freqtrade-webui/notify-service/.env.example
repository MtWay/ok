# Server configuration
PORT=3031

# Proxy configuration (optional, for accessing OKX API)
# HTTPS_PROXY=http://127.0.0.1:7890

# Email configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-password

# Freqtrade dry-run API (keep the service bound to localhost)
FREQTRADE_API_URL=http://127.0.0.1:8091
# Freqtrade config file rewritten by POST /api/notify/whitelist (hot-reloaded
# afterwards via /reload_config). Must be writable by this service.
# FREQTRADE_CONFIG=/work/ok/freqtrade_userdir/config_okx_futures_dryrun.json
# Prefer a long-lived token. Otherwise set the API credentials below.
# FREQTRADE_API_TOKEN=
# FREQTRADE_API_USER=freqtrader
# FREQTRADE_API_PASSWORD=replace-me

# Automatic plan approval is disabled unless explicitly enabled in dry-run.
TRADING_DRY_RUN=false
# Fixed margin (USDT) per auto-approved plan; notional = margin x leverage.
TRADING_FIXED_MARGIN=300
# Equity/risk-fraction sizing only applies to manually created plans that
# omit an explicit margin.
TRADING_DRY_RUN_EQUITY=10000
TRADING_RISK_FRACTION=0.005
# Execution is opt-in and still guarded by TRADING_DRY_RUN=true.
TRADING_EXECUTION_ENABLED=false
# Failed forceenter calls retry at 15s, 30s, then stop after 3 total attempts.
# No pair whitelist: every scanned OKX USDT swap is tradable. Freqtrade uses
# StaticPairList with the ".*/USDT:USDT" wildcard in config_okx_futures_dryrun.json.
# Hard stop-loss percent (fees included) applied to every open plan. This is
# the floor only: the effective hard stop sits just beyond each plan's own
# stopPrice (stop distance x leverage x 1.2), whichever is wider.
TRADING_HARD_STOP_PERCENT=3
# Freqtrade trades not tracked by any plan are force-closed automatically
# (the strategy owns no exits). Set to false to keep them.
TRADING_CLOSE_ORPHANS=true
