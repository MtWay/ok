# ============================================================
# Production config — COPY THIS TO .env BEFORE STARTING
# do NOT commit real API keys or passwords.
# ============================================================

# Server configuration
PORT=3031

# Proxy configuration (required for OKX access from CN networks)
HTTPS_PROXY=http://127.0.0.1:7890

# Email configuration (optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-password

# Freqtrade live API — must match api_server in config_okx_futures_live.json
FREQTRADE_API_URL=http://127.0.0.1:8091
FREQTRADE_API_USER=freqtrader
FREQTRADE_API_PASSWORD=cdca618bb1073f21330fc158a77ba6cfe0965e0a0560ffac

# Live trading — paper-trading approval disabled, real execution enabled.
TRADING_DRY_RUN=false
TRADING_RISK_FRACTION=0.005
TRADING_EXECUTION_ENABLED=true

# Comma-separated pair whitelist. Keep aligned with config_okx_futures_live.json.
TRADING_ALLOWED_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
