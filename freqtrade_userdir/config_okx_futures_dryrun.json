{
  "bot_name": "freqtrade_okx_futures_dryrun",
  "dry_run": true,
  "dry_run_wallet": 200,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 30,
  "stake_currency": "USDT",
